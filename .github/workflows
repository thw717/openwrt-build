name: Build OpenWrt‑25.12 x86_64 All‑in‑One
on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build_firmware:
    runs-on: ubuntu-22.04
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup OpenWrt build environment
        uses: openwrt/actions-setup-buildenv@v1

      - name: Clone OpenWrt 25.12 branch
        run: |
          git clone https://git.openwrt.org/openwrt/openwrt.git openwrt
          cd openwrt
          git checkout openwrt-25.12

      - name: Add custom feeds nft-fullcone
        run: |
          cd openwrt
          echo "src-git nftfullcone https://github.com/fullcone-n/nft-fullcone.git" >> feeds.conf.default
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Generate .config
        run: |
          cd openwrt
          make defconfig
          ## Target x86_64 Generic
          echo "CONFIG_TARGET_x86=y" >> .config
          echo "CONFIG_TARGET_x86_64=y" >> .config
          echo "CONFIG_TARGET_x86_64_Generic=y" >> .config

          ## nft‑fullcone FullCone NAT
          echo "CONFIG_PACKAGE_nft-fullcone=y" >> .config

          ## Base LuCI 中文汉化
          echo "CONFIG_PACKAGE_luci=y" >> .config
          echo "CONFIG_PACKAGE_luci-base=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-base-zh-cn=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y" >> .config

          ## ttyd 网页终端
          echo "CONFIG_PACKAGE_luci-app-ttyd=y" >> .config

          ## UPnP nftables版本
          echo "CONFIG_PACKAGE_miniupnpd-nftables=y" >> .config
          echo "CONFIG_PACKAGE_luci-app-upnp=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y" >> .config

          ## ddns‑scripts 系列 cloudflare dnspod
          echo "CONFIG_PACKAGE_ddns-scripts=y" >> .config
          echo "CONFIG_PACKAGE_luci-app-ddns=y" >> .config
          echo "CONFIG_PACKAGE_ddns-scripts-cloudflare=y" >> .config
          echo "CONFIG_PACKAGE_ddns-scripts-dnspod=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y" >> .config

          ## curl ca证书
          echo "CONFIG_PACKAGE_curl=y" >> .config
          echo "CONFIG_PACKAGE_ca-certificates=y" >> .config

          ## uhttpd 网页服务 汉化
          echo "CONFIG_PACKAGE_luci-app-uhttpd=y" >> .config
          echo "CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y" >> .config

          ## 温度监控 collectd thermal
          echo "CONFIG_PACKAGE_luci-app-statistics=y" >> .config
          echo "CONFIG_PACKAGE_collectd-mod-thermal=y" >> .config
          echo "CONFIG_PACKAGE_kmod-thermal=y" >> .config
          echo "CONFIG_PACKAGE_kmod-hwmon-core=y" >> .config

          ## ddns‑go ddnsto
          echo "CONFIG_PACKAGE_ddns-go=y" >> .config
          echo "CONFIG_PACKAGE_ddnsto=y" >> .config

          ## 禁用多余镜像减少编译体积
          echo "CONFIG_TARGET_x86_64_Generic_GRUB_EFI_IMG=n" >> .config

          make oldconfig

      - name: Download all source
        run: cd openwrt && make download -j$(nproc)

      - name: Compile firmware
        run: cd openwrt && make -j$(nproc)

      - name: Upload firmware artifact
        uses: actions/upload-artifact@v4
        with:
          name: OpenWrt‑25.12‑x86_64‑fullcone‑all
          path: openwrt/bin/targets/x86/64/*.img.gz
