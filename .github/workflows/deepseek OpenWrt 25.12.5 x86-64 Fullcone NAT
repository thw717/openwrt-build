name: Build OpenWrt 25.12.5 x86-64 (Fullcone NAT)

on:
  workflow_dispatch:
  push:
    branches: [ main ]

env:
  OPENWRT_TAG: v25.12.5
  OPENWRT_BRANCH_FALLBACK: openwrt-25.12
  OPENWRT_REPO: https://github.com/openwrt/openwrt.git

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 360

    steps:
      - name: Checkout this repo
        uses: actions/checkout@v4

      # ---------------- 环境准备 ----------------
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
                      /opt/hostedtoolcache/CodeQL /usr/local/share/boost \
                      /usr/local/lib/node_modules /opt/az /usr/lib/jvm || true
          df -h

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            ack antlr3 asciidoc autoconf automake autopoint binutils bison \
            build-essential bzip2 ccache clang cmake cpio curl \
            device-tree-compiler ecj fastjar flex gawk gettext gcc-multilib \
            g++-multilib git gperf haveged help2man intltool lib32gcc-s1 \
            libc6-dev-i386 libelf-dev libglib2.0-dev libgmp3-dev libltdl-dev \
            libmpc-dev libmpfr-dev libncurses5-dev libncursesw5 libncursesw5-dev \
            libreadline-dev libssl-dev libtool libyaml-dev lrzsz mkisofs msmtp \
            nano ninja-build p7zip p7zip-full patch pkgconf python3 python3-pip \
            python3-ply python3-pyelftools python3-setuptools qemu-utils re2c \
            rsync scons squashfs-tools subversion swig texinfo uglifyjs upx-ucl \
            unzip vim wget xmlto xxd zlib1g-dev file

      # ---------------- 拉取源码 ----------------
      - name: Clone OpenWrt
        run: |
          if git ls-remote --tags "$OPENWRT_REPO" "refs/tags/${OPENWRT_TAG}" | grep -q "${OPENWRT_TAG}"; then
            echo "==> Using tag: ${OPENWRT_TAG}"
            git clone --depth=1 -b "${OPENWRT_TAG}" "$OPENWRT_REPO" openwrt
          else
            echo "==> Tag ${OPENWRT_TAG} not found, fallback to branch ${OPENWRT_BRANCH_FALLBACK}"
            git clone --depth=1 -b "${OPENWRT_BRANCH_FALLBACK}" "$OPENWRT_REPO" openwrt
          fi
          cd openwrt
          git log -1 --oneline

      - name: Update & install feeds
        run: |
          cd openwrt
          ./scripts/feeds update -a
          ./scripts/feeds install -a

      # ---------------- Fullcone: 内核模块 ----------------
      - name: Integrate nft-fullcone (auto-detect)
        run: |
          set -e
          cd openwrt

          if [ -d package/network/utils/nft-fullcone ]; then
            echo "==> nft-fullcone already present in official tree, skip."
          else
            echo "==> Fetching nft-fullcone from immortalwrt ..."
            rm -rf /tmp/imm
            git clone --depth=1 --filter=blob:none --sparse \
              https://github.com/immortalwrt/immortalwrt.git /tmp/imm
            (
              cd /tmp/imm
              git sparse-checkout set package/network/utils/nft-fullcone
            )
            mkdir -p package/network/utils/nft-fullcone
            cp -a /tmp/imm/package/network/utils/nft-fullcone/. \
                  package/network/utils/nft-fullcone/

            # 尝试把 conntrack-events 内核 hack 补丁一并拷过来（若目标内核版本目录存在）
            for SRC_HACK in /tmp/imm/target/linux/generic/hack-*; do
              [ -d "$SRC_HACK" ] || continue
              KVER_DIR=$(basename "$SRC_HACK")
              if [ -d "target/linux/generic/$KVER_DIR" ]; then
                echo "==> Copying conntrack hack patches into $KVER_DIR"
                cp -n "$SRC_HACK"/952-*.patch "target/linux/generic/$KVER_DIR/" 2>/dev/null || true
                cp -n "$SRC_HACK"/953-*.patch "target/linux/generic/$KVER_DIR/" 2>/dev/null || true
              fi
            done
          fi

          ls -la package/network/utils/nft-fullcone/

      # ---------------- Fullcone: LuCI 复选框 ----------------
      - name: Patch luci-app-firewall (add Fullcone checkbox)
        run: |
          set -e
          cd openwrt

          # 自动定位含 flow_offloading 的 zones.js
          TARGET=$(grep -rl "flow_offloading" \
                     feeds/luci/applications/luci-app-firewall/htdocs/ 2>/dev/null \
                   | head -n1)

          if [ -z "$TARGET" ]; then
            echo "==> Cannot locate zones.js anchor, skip LuCI patch (assume upstream already supports it)."
            exit 0
          fi
          echo "==> Target file: $TARGET"

          if grep -q "form.Flag, 'fullcone'" "$TARGET"; then
            echo "==> fullcone option already exists, skip."
            exit 0
          fi

          python3 - "$TARGET" <<'PYEOF'
          import re, sys
          path = sys.argv[1]
          src = open(path, encoding='utf-8').read()

          snippet = (
              "\to = s.option(form.Flag, 'fullcone', _('Fullcone NAT'));\n"
              "\to.default = '0';\n"
              "\to.rmempty = false;\n"
              "\to.description = _('Enable Fullcone NAT (requires kmod-nft-fullcone). '\n"
              "\t\t+ 'Improves P2P / game NAT type, may reduce throughput.');\n\n"
          )

          pattern = re.compile(
              r"(\n)(\t*)o = s\.option\(form\.Flag, 'flow_offloading',"
              r" _\('Software flow offloading'\)\);"
          )
          def repl(m):
              return m.group(1) + snippet + m.group(2) + (
                  "o = s.option(form.Flag, 'flow_offloading',"
                  " _('Software flow offloading'));"
              )
          new_src, n = pattern.subn(repl, src, count=1)
          if n == 0:
              print("ERROR: flow_offloading anchor not matched", file=sys.stderr)
              sys.exit(1)
          open(path, 'w', encoding='utf-8').write(new_src)
          print("==> fullcone option inserted into", path)
          PYEOF

      # ---------------- 写入 .config ----------------
      - name: Prepare .config
        run: |
          cd openwrt
          cat > .config <<'EOF'
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# 防火墙栈
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y

# Fullcone 内核模块
CONFIG_PACKAGE_kmod-nft-fullcone=y

# LuCI 基础中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ttyd
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# UPnP (nftables 版)
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# 网络工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y

# uhttpd
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y

# 状态统计 + 温度
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_kmod-thermal=y
CONFIG_PACKAGE_kmod-hwmon-core=y
EOF

          make defconfig

          echo "===== Sanity check ====="
          for k in kmod-nft-fullcone luci-app-firewall firewall4 \
                   luci-app-upnp ddns-scripts-cloudflare luci-app-ttyd \
                   luci-app-statistics collectd-mod-thermal; do
            if grep -q "CONFIG_PACKAGE_${k}=y" .config; then
              echo "OK   $k"
            else
              echo "MISS $k"
            fi
          done
          echo "========================="

      - name: Show final config snippet
        run: |
          cd openwrt
          grep -E "CONFIG_TARGET_(x86|rootfs|grub)|fullcone" .config || true

      # ---------------- 下载 & 编译 ----------------
      - name: Download package sources
        run: |
          cd openwrt
          make download -j"$(nproc)" V=s

      - name: Build firmware
        run: |
          cd openwrt
          make -j"$(nproc)" V=s || make -j1 V=s

      # ---------------- 上传产物 ----------------
      - name: Collect artifacts
        run: |
          mkdir -p /tmp/artifact
          cp -v openwrt/bin/targets/x86/64/*.img.gz        /tmp/artifact/ 2>/dev/null || true
          cp -v openwrt/bin/targets/x86/64/*.manifest      /tmp/artifact/ 2>/dev/null || true
          cp -v openwrt/bin/targets/x86/64/sha256sums      /tmp/artifact/ 2>/dev/null || true
          cp -v openwrt/bin/targets/x86/64/*.kmod.tar      /tmp/artifact/ 2>/dev/null || true
          ls -lh /tmp/artifact

      - name: Upload firmware artifact
        uses: actions/upload-artifact@v4
        with:
          name: openwrt-x86-64-25.12.5-fullcone
          path: /tmp/artifact/*
          if-no-files-found: error
          retention-days: 30
